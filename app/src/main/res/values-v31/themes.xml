<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: white bg + vector hanger (inset) — avoids solid-circle PNG scaling. -->
    <style name="Theme.Fashandroidmobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_fash_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
