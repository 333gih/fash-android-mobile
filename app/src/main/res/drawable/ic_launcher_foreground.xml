<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground (API 26+): white hanger on transparent.
  Magenta field lives in ic_launcher_background.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="52dp"
        android:height="52dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_foreground_mark" />
    </item>
</layer-list>
