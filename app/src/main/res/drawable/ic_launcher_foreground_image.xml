<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground mark capped at 44dp (inside 66dp safe zone) so squircle/circle masks do not clip wide hanger. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="44dp"
        android:height="44dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_foreground_mark" />
    </item>
</layer-list>
