<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: sent with meetup check-in when the user grants location access -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <queries>
        <package android:name="com.facebook.katana" />
    </queries>

    <application
        android:name=".FashApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fashandroidmobile"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fash_general" />

        <service
            android:name=".notifications.FashFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notifications.GuestLocalReengagementReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.pc.fash_android_mobile.GUEST_LOCAL_REMINDER_FIRE" />
            </intent-filter>
        </receiver>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Fashandroidmobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Android App Links: HTTPS verified by `/.well-known/assetlinks.json` on the share host.
              Single intent-filter with `autoVerify="true"` covers all three share surfaces (listing,
              profile, invite); Android requires they share an autoVerify=true filter to issue one
              verification request per host.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${listingShareHost}"
                    android:pathPrefix="/p/l/" />
                <data
                    android:scheme="https"
                    android:host="${listingShareHost}"
                    android:pathPrefix="/p/u/" />
                <data
                    android:scheme="https"
                    android:host="${listingShareHost}"
                    android:pathPrefix="/invite" />
            </intent-filter>
            <!-- HTTP fallback (e.g. dev or non-TLS environments) — not auto-verified. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="http"
                    android:host="${listingShareHost}"
                    android:pathPrefix="/p/l/" />
                <data
                    android:scheme="http"
                    android:host="${listingShareHost}"
                    android:pathPrefix="/p/u/" />
                <data
                    android:scheme="http"
                    android:host="${listingShareHost}"
                    android:pathPrefix="/invite" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="fash"
                    android:host="listing"
                    android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="fash"
                    android:host="profile"
                    android:pathPrefix="/" />
            </intent-filter>
            <!-- In-app + FCM deep link: fash://inbox/{notification_ledger_id} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="fash"
                    android:host="inbox"
                    android:pathPrefix="/" />
            </intent-filter>
            <!-- Invite friends share link: fash://invite?ref=username -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="fash"
                    android:host="invite" />
            </intent-filter>
        </activity>
    </application>

</manifest>
