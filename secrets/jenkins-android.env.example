# Jenkins secret file template — credential ID: env-fash-android-mobile-<dev|prod>
#
# Create in Jenkins: Credentials → Secret file → ID env-fash-android-mobile-prod
# Copy this file, fill values, upload. Do NOT commit the filled file.
#
# Multiline env files: base64-encode local env/dev.env and env/prod.env (see below).
#
#   Linux/macOS:
#     base64 -w0 env/dev.env   # or base64 env/dev.env | tr -d '\n'
#     base64 -w0 env/prod.env
#   PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("env\dev.env"))
#
# Keystore + Play JSON: same as secrets/android-release.env.example / GitHub secrets.

ANDROID_DEV_ENV_B64=
ANDROID_PROD_ENV_B64=

ANDROID_UPLOAD_KEYSTORE_BASE64=
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
ANDROID_UPLOAD_KEY_ALIAS=upload
ANDROID_UPLOAD_KEY_PASSWORD=

GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional overrides (Jenkins job parameters usually set PLAY_TRACK)
# PLAY_TRACK=FASH-production
# PLAY_PACKAGE_NAME=com.pc.fash_android_mobile
