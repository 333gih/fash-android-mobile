# Copy to secrets/android-release.env (gitignored) and fill in values.
# Do NOT commit android-release.env, upload keystore, or Play service account JSON.
#
# Upload to GitHub Actions (repo <owner>/fash-android-mobile):
#   Windows:  .\scripts\push_github_android_secrets.ps1
#   Mac/Linux: ./scripts/push_github_android_secrets.sh
#
# Requires: GitHub CLI (`gh auth login`) with repo admin.

# --- Build env (bắt buộc cho Android Build + Release) ---
# Đường dẫn tương đối repo — script đọc toàn bộ file lên secret multiline.
ANDROID_DEV_ENV_PATH=env/dev.env
ANDROID_PROD_ENV_PATH=env/prod.env

# --- Upload keystore (bắt buộc cho Android Release / Play) ---
ANDROID_UPLOAD_KEYSTORE_PATH=secrets/upload.keystore
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
# Alias trong secrets/upload.keystore — keytool -list -keystore secrets/upload.keystore
# key0 → SHA1 5C:E7:... (Play upload key — dùng cho CI) | upload → SHA1 82:9D:... (key mới, cần reset Play)
ANDROID_UPLOAD_KEY_ALIAS=key0
ANDROID_UPLOAD_KEY_PASSWORD=

# Hoặc dán base64 sẵn (bỏ qua PATH nếu dùng dòng này):
# ANDROID_UPLOAD_KEYSTORE_BASE64=

# --- Google Play API (bắt buộc khi upload Play từ CI) ---
# Tải JSON từ Play Console → API access → service account key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=secrets/play-service-account.json

# Hoặc dán toàn bộ JSON một dòng (không khuyến nghị):
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Play track — tên kênh trên Play Console (Closed testing custom track, KHÔNG phải alpha mặc định)
# Ví dụ: FASH-production (track user đang xem trên Console)
PLAY_TRACK=FASH-production

# SHA-1 upload key đã đăng ký trên Play Console (Setup → App signing → Upload key certificate).
# CI so khớp trước khi upload — tránh lỗi "signed with the wrong key" muộn.
# key0 (cert cũ trên Play): 5C:E7:3A:D0:24:DA:46:3B:63:9A:23:90:6E:A5:1A:A5:D9:50:20:09
# upload (keystore mới secrets/upload.keystore): 82:9D:04:0D:8D:0B:94:E9:9A:7B:9A:2C:A1:1D:D8:F6:06:C2:73:F1
PLAY_EXPECTED_UPLOAD_SHA1=

# --- Firebase google-services.json (Google Sign-In — KHÁC play-service-account.json) ---
# Sau khi thêm SHA-1 (debug + upload + Play App signing) trên Firebase:
#   python tools/register_firebase_sha.py --play-app-signing-sha1 "XX:XX:..."
# hoặc tải thủ công từ Firebase Console -> Project settings.
# File phải có oauth_client với client_type 1 cho prod + dev package.
GOOGLE_SERVICES_JSON_PATH=app/google-services.json
