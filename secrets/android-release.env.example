# Copy to secrets/android-release.env (gitignored) and fill in values.
# Do NOT commit android-release.env, upload keystore, or Play service account JSON.
#
# Upload to GitHub Actions (repo <owner>/fash-android-mobile):
#   Windows:  .\scripts\push_github_android_secrets.ps1
#   Mac/Linux: ./scripts/push_github_android_secrets.sh
#
# Requires: GitHub CLI (`gh auth login`) with repo admin.

# --- Build env (bắt buộc cho Android Build + Release) ---
# Đường dẫn tương đối repo — script đọc toàn bộ file lên secret multiline.
ANDROID_DEV_ENV_PATH=env/dev.env
ANDROID_PROD_ENV_PATH=env/prod.env

# --- Upload keystore (bắt buộc cho Android Release / Play) ---
ANDROID_UPLOAD_KEYSTORE_PATH=secrets/upload.keystore
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
# Must match Play upload cert — run: keytool -list -keystore secrets/upload.keystore
# key0 → SHA1 5C:E7:3A:D0:... (Play expects) | upload → wrong key for Play
ANDROID_UPLOAD_KEY_ALIAS=key0
ANDROID_UPLOAD_KEY_PASSWORD=

# Hoặc dán base64 sẵn (bỏ qua PATH nếu dùng dòng này):
# ANDROID_UPLOAD_KEYSTORE_BASE64=

# --- Google Play API (bắt buộc khi upload Play từ CI) ---
# Tải JSON từ Play Console → API access → service account key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=secrets/play-service-account.json

# Hoặc dán toàn bộ JSON một dòng (không khuyến nghị):
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
